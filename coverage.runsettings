<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <!-- Business-logic code only: the API, the projects it references, and its client SDK.
                         AppHost (Aspire orchestration), TrafficGen (load tool), TestSupport and EF migrations
                         are deliberately out — do not write tests to cover them. -->
                    <Include>
                        [DKNet.Accounts.Api]*,
                        [DKNet.Accounts.AppServices]*,
                        [DKNet.Accounts.Infra]*,
                        [DKNet.Accounts.Domains]*,
                        [DKNet.Accounts.Share]*,
                        [DKNet.Accounts.Client]*
                    </Include>
                    <Exclude>
                        [DKNet.Accounts.AppHost]*,
                        [DKNet.Accounts.TrafficGen]*,
                        [DKNet.Accounts.App.TestSupport]*,
                        [*Tests]*
                    </Exclude>
                    <ExcludeByFile>
                        **/bin/**,
                        **/obj/**,
                        **/*Tests.cs,
                        **/*Test.cs,
                        **/TestObjects/**,
                        **/GlobalUsings.cs,
                        **/*.g.cs,
                        **/Migrations/**
                    </ExcludeByFile>
                    <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
