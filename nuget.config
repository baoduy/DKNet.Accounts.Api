<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/baoduy/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="DKNet.Notification.*" />
    </packageSource>
  </packageSourceMapping>
  <!-- Keep vulnerability checks on nuget.org; the package feed has no audit data. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="baoduy" />
      <!-- Locally, export GITHUB_PACKAGES_TOKEN with a classic PAT scoped to read:packages. -->
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </github>
  </packageSourceCredentials>
</configuration>
