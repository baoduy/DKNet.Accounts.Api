  "cards": [
    {
      "dot": "cyan",
      "title": "Why this route stays hand-written",
      "items": [
        "The refusal reads Account, not Currency \u2014 a generated [CrudAction] handler can only see the aggregate it mutates",
        "The entity method Deactivate() itself carries no guard at all"
      ]
    },
    {
      "dot": "amber",
      "title": "What this can't show",
      "items": [
        "Existing accounts and historical postings remain stored after deactivation",
        "RecordPostingCommandHandler refuses a new posting in an inactive currency with UNSUPPORTED_CURRENCY; ReversePostingCommandHandler does not check currency activity"
      ]
    }
  ]
