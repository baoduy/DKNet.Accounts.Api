  "activations": [],
  "cards": [
    {
      "dot": "cyan",
      "title": "Exempt from the floor, not from status",
      "items": [
        "A reversal may leave the account below its floor \u2014 that is a real, readable debt",
        "The account status gate and amount ceiling still apply in the reversal direction"
      ]
    },
    {
      "dot": "amber",
      "title": "Two events, one save",
      "items": [
        "The reversing posting's postings.created and the original's postings.updated are both raised from the one SaveChanges call that links them"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local reversal checks",
      "items": [
        "ReversePostingCommandHandler reads original.AccountId without tracking before taking its account lock",
        "Inside the lock it re-reads the original, refuses POSTING_ALREADY_REVERSED or POSTING_IS_REVERSAL, then loads the account",
        "Account.TryApplyPosting applies the opposite direction with isReversal=true: the floor is skipped, but status and amount ceiling still apply"
      ]
    }
  ]
