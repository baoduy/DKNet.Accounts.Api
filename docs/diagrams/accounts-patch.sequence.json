  "cards": [
    {
      "dot": "cyan",
      "title": "Two separate update routes",
      "items": [
        "PUT changes name/metadata only \u2014 a different route entirely",
        "PATCH changes status and the three floor controls only; neither route overlaps the other's fields"
      ]
    },
    {
      "dot": "amber",
      "title": "What this can't show",
      "items": [
        "accounts.updated is raised only when this route actually changes a tracked field \u2014 never on a posting's balance movement alone"
      ]
    },
    {
      "dot": "emerald",
      "title": "Handler-owned guard",
      "items": [
        "UpdateAccountCommandHandler merges supplied floor controls with stored values",
        "It refuses OVERDRAFT_LIMIT_REQUIRED or ACCOUNT_HOLDS_BALANCE before a successful save"
      ]
