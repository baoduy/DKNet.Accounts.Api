  "cards": [
    {
      "dot": "cyan",
      "title": "Two separate update routes",
      "items": [
        "PUT changes name/metadata only — a different route entirely",
        "PATCH changes status and the three floor controls only; neither route overlaps the other's fields"
      ]
    },
    {
      "dot": "amber",
      "title": "What this can't show",
      "items": [
        "accounts.updated is raised only when this route actually changes a tracked field — never on a posting's balance movement alone"
      ]
    },
    {
      "dot": "slate",
      "title": "Checks and outcomes",
      "items": [
        "PATCH /v1/accounts/{id}: Optional status, overdraftLimit, minimumBalance and permittedToGoNegative fields",
        "merge supplied controls with the stored ones — still determinate?: AccountFloorPolicy.RequiresOverdraftLimit on the merged state",
        "determinate: Otherwise refused: 422 OVERDRAFT_LIMIT_REQUIRED. Closing while Balance != 0 or HeldAmount != 0 is refused: 422 ACCOUNT_HOLDS_BALANCE",
        "ChangeStatus / update controls, one save: ClosedOn is set when Status becomes Closed, cleared on any other status change"
      ]
    },
    {
      "dot": "emerald",
      "title": "Handler-owned guard",
      "items": [
        "UpdateAccountCommandHandler merges supplied floor controls with stored values",
        "It refuses OVERDRAFT_LIMIT_REQUIRED or ACCOUNT_HOLDS_BALANCE before a successful save"
      ]
    }
  ]
