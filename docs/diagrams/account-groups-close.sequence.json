  "cards": [
    {
      "dot": "cyan",
      "title": "Why this route stays hand-written",
      "items": [
        "The refusal reads Account, not AccountGroup \u2014 a generated [CrudAction] handler can only see the aggregate it mutates"
      ]
    },
    {
      "dot": "amber",
      "title": "What this can't show",
      "items": [
        "DELETE is refused with GROUP_NOT_EMPTY whenever the group contains any account, including closed zero-balance accounts"
      ]
    },
    {
      "dot": "slate",
      "title": "Checks and outcomes",
      "items": [
        "any account with Balance != 0 or HeldAmount != 0?: SpecListAccounts(groupId) \u2014 a different aggregate than the one being closed",
        "none found: Otherwise refused: 422 GROUP_HOLDS_BALANCE, and the group status is unchanged"
      ]
    }
  ]
