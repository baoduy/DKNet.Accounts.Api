  "cards": [
    { "dot": "cyan", "title": "Lock after the idempotency pre-check", "items": ["A deliberate, documented trade-off: two first-uses of the same key can both miss that read", "The second is refused 409 by the database's own unique index on (CallingSystem, IdempotencyKey), not silently double-posted"] },
    { "dot": "amber", "title": "What this can't show", "items": ["The per-account lock is single-process, in-memory — correct for one instance, not a horizontally-scaled deployment", "The account's own status-gate and floor rules are Accounts' domain logic, applied here through TryApplyPosting"] }
