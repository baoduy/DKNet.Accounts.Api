  "cards": [
    {
      "dot": "cyan",
      "title": "Entirely hand-written",
      "items": [
        "Account carries no [CrudCreate] constructor \u2014 account-number allocation and the floor/currency checks are all handler logic"
      ]
    },
    {
      "dot": "amber",
      "title": "What this can't show",
      "items": [
        "The transaction boundary is the one SaveChanges call: entity and enabled outbox row commit together or not at all",
        "A posting against this account is a separate flow \u2014 see Postings"
      ]
    },
    {
      "dot": "emerald",
      "title": "Handler-owned checks",
      "items": [
        "OpenAccountCommandHandler checks currency activity, floor determinacy and group existence",
        "The floor check is local to the handler, between the currency and group lookups"
      ]
    }
  ]
