  "cards": [
    {
      "dot": "cyan",
      "title": "Entirely hand-written",
      "items": [
        "Account carries no [CrudCreate] constructor — account-number allocation and the floor/currency checks are all handler logic"
      ]
    },
    {
      "dot": "amber",
      "title": "What this can't show",
      "items": [
        "The transaction boundary is the one SaveChanges call: entity and enabled outbox row commit together or not at all",
        "A posting against this account is a separate flow — see Postings"
      ]
    },
    {
      "dot": "slate",
      "title": "Checks and outcomes",
      "items": [
        "all pass: Otherwise refused: 422 UNSUPPORTED_CURRENCY, 404 unknown group, or 422 OVERDRAFT_LIMIT_REQUIRED",
        "insert Account + outbox row, one save: accountNumber = \"{group.Code}-{suffix}\" (caller's suffix or a generated one); new Account(...), Status = Active, Balance = 0",
        "accounts.created event: Dropped, not stored, if the bus is off. Retried indefinitely from the outbox if the bus is on but unreachable."
      ]
    },
    {
      "dot": "emerald",
      "title": "Handler-owned checks",
      "items": [
        "OpenAccountCommandHandler checks currency activity, floor determinacy and group existence",
        "The floor check is local to the handler, between the currency and group lookups"
      ]
    }
  ]
