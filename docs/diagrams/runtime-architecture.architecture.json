  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Browser holds only a session cookie; BFF keeps tokens in Redis",
        "API: issuer, audience, signature, lifetime + scp scope; default-deny",
        "Helm: console HTTPRoute public, API ClusterIP only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write path",
      "items": [
        "Rate limit, timeouts, auth, then FluentValidation",
        "Postings: Idempotency-Key replay via unique DB index",
        "Per-account SemaphoreSlim lock: single replica only"
      ]
    },
    {
      "dot": "amber",
      "title": "Platform",
      "items": [
        "MessageBus__Transport: RabbitMQ local, ASB on AKS",
        "Machine callers: TrafficGen, DKNet.Accounts.Client",
        "Key Vault via CSI; OTLP / Azure Monitor telemetry"
      ]
    }
  ]
