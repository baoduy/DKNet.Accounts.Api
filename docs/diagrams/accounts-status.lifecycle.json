  "cards": [
    {
      "dot": "cyan",
      "title": "Any status to any status",
      "items": [
        "PATCH /v1/accounts/{id} can set Active, Frozen, Dormant or Closed from any current status",
        "The PATCH status decision represents a request, not a stored status"
      ]
    },
    {
      "dot": "amber",
      "title": "The only status-change guard",
      "items": [
        "Entering Closed is refused with ACCOUNT_HOLDS_BALANCE when Balance or HeldAmount is non-zero",
        "Frozen refuses all postings; Dormant refuses debits, including a debiting reversal"
