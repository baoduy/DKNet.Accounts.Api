# cp .env.sample .env — docker compose reads it for both substitution and the api container.

# --- compose-level (substituted into docker-compose.yml) ---
POSTGRES_PASSWORD=accounts
API_PORT=8080

# --- FeatureManagement (DKNet.Accounts.Share.Options.FeatureOptions) ---
# Values below are the defaults this compose stack runs with; the code defaults
# differ where noted.
FeatureManagement__EnableAntiforgery=false
FeatureManagement__EnableAzureAppConfig=false
FeatureManagement__EnableHealthCheck=true
# TLS/HSTS belongs to the proxy in front of this container, not the app.
FeatureManagement__EnableHttps=false
FeatureManagement__EnableOpenTelemetry=false
FeatureManagement__EnableRateLimit=true
# No Azure Service Bus in this stack.
FeatureManagement__EnableServiceBus=false
FeatureManagement__EnableSwagger=false
FeatureManagement__EnableVersioning=true
# Off so the stack boots without an IdP. Turn on together with the Authentication__* values.
FeatureManagement__RequireAuthorization=false
# Applies EF migrations at startup against the postgres service.
FeatureManagement__RunDbMigrationWhenAppStart=true
FeatureManagement__EnableSecurityHeaders=true
# Honoured only for proxies listed in Security__TrustedProxies__0.. (empty = forwarded headers ignored).
FeatureManagement__EnableForwardedHeaders=true
FeatureManagement__EnableRequestBounds=true

# --- Auth (required when FeatureManagement__RequireAuthorization=true) ---
Authentication__Schemes__Bearer__MetadataAddress=
Authentication__Schemes__Bearer__ValidAudiences__0=
Authentication__Schemes__Bearer__ValidIssuer=

# --- Optional ---
# Security__TrustedProxies__0=10.0.0.0/8
# Cors__AllowedOrigins__0=https://app.example.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# AzureMonitor__ConnectionString=
# ConnectionStrings__AzureBus=

# --- Console (ui/) — fill in the directory values below to enable sign-in ---
CONSOLE_PORT=3000
CONSOLE_BASE_URL=http://localhost:3000
# Blank tenant/client starts the console in its "not configured" mode (R9).
CONSOLE_ENTRA_TENANT_ID=
CONSOLE_ENTRA_CLIENT_ID=
CONSOLE_ENTRA_CLIENT_SECRET=
CONSOLE_ENTRA_SCOPES=accounts.read postings.read postings.reverse
# Overridden by compose to the in-network api/redis addresses; only used outside compose.
CONSOLE_API_BASE_URL=http://localhost:8080
CONSOLE_REDIS_URL=redis://localhost:6379
CONSOLE_REDIS_KEY_PREFIX=console:
# A self-evident placeholder (not blank): the whole stack must boot on this file as-is,
# unmodified, straight into the not-configured page — only the directory values above are
# genuinely unknowable ahead of time. Replace before any real deployment.
CONSOLE_SESSION_SECRET=REPLACE-ME-BEFORE-DEPLOY-SESSION-SECRET
# Exactly 32 bytes (used as the raw AES-256 key) — same self-evident-placeholder rule as above.
CONSOLE_TOKEN_ENCRYPTION_KEY=REPLACE-ME-BEFORE-DEPLOY-0000000
