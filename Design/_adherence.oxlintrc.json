{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/ledger/**",
              "components/shell/**",
              "ui_kits/account-detail/**",
              "ui_kits/account-groups-crud/**",
              "ui_kits/accounts-crud/**",
              "ui_kits/currencies-crud/**",
              "ui_kits/overview/**",
              "ui_kits/records-crud/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Id'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|href|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<Id> doesn't accept that prop. Declared props: value, href, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:sidebar|breadcrumb|topbarRight|panel|panelOpen|panelBehavior|children|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: sidebar, breadcrumb, topbarRight, panel, panelOpen, panelBehavior, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='panelBehavior'] > Literal[value!=/^(?:overlay|shift)$/]",
        "message": "<AppShell> panelBehavior must be one of 'overlay' | 'shift'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:credit|debit|warning|info|neutral)$/]",
        "message": "<Badge> tone must be one of 'credit' | 'debit' | 'warning' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountBalanceShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:balance|availableBalance|heldAmount|currency|decimalPlaces|key|ref|className|style|children)$/]",
        "message": "<AccountBalanceShape> doesn't accept that prop. Declared props: balance, availableBalance, heldAmount, currency, decimalPlaces."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|id|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, href, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|href|icon|children|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, href, icon, children, onClick, type, style."
      },
