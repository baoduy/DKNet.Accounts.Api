        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'ghost' | 'destructive'."
