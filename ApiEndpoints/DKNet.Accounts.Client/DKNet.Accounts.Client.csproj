<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>DKNet.Accounts.Client</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageDescription>
            Typed .NET client for the DKNet Accounts service. Requires a GitHub personal access token with
            read:packages scope to restore: add a NuGet.Config source authenticated with that token (e.g. via
            the NUGET_GITHUB_TOKEN/GH_TOKEN environment variable), never committing the token itself.
        </PackageDescription>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>
</Project>
