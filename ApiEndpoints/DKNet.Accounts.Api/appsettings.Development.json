{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "None",
      "Microsoft.Hosting.Lifetime": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ApplicationInsights": {
    "InstrumentationKey": ""
  },
  "RateLimit": {
    "DefaultRequestLimit": 1,
    "DefaultConcurrentLimit": 1,
    "TimeWindowInSeconds": 10
  },
  "FeatureManagement": {
    "EnableHttps": false,
    "EnableSwagger": true,
    "EnableAntiforgery": false,
    "EnableServiceBus": false,
    "RequireAuthorization": false,
    "RunDbMigrationWhenAppStart": true,
    "EnableRateLimit": false,
    "EnableAzureAppConfig": false,
    "EnableSecurityHeaders": true,
    "EnableForwardedHeaders": true,
    "EnableRequestBounds": true
  },
  "MessageBus": {
    "Transport": "RabbitMq"
  },
  "ConnectionStrings": {
    "AppDb": "",
    "AzureBus": "",
    "RabbitMq": "amqp://guest:guest@localhost:5672/"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5000"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}